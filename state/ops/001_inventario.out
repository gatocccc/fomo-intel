--- nginx
fomo
gaucha
simplai
## /etc/nginx/sites-enabled/fomo
server {
    server_name fomo.nonconformistducks.com;

    root /var/www/fomo;
    index index.html;

    auth_basic "FOMO Intel";
    auth_basic_user_file /etc/nginx/.htpasswd_fomo;

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-store";
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/fomo.nonconformistducks.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/fomo.nonconformistducks.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = fomo.nonconformistducks.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name fomo.nonconformistducks.com;
    return 404; # managed by Certbot


}## /etc/nginx/sites-enabled/gaucha
server {
    server_name gauchaba.com www.gauchaba.com;
    root /home/gaucha-preview;
    index index.html;
    location /Q1/ {
        auth_basic "Gaucha · Reporte interno";
        auth_basic_user_file /etc/nginx/.htpasswd-q1;
        try_files $uri $uri/ =404;
    }
location / {
        try_files $uri $uri/ =404;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/gauchaba.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/gauchaba.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = gauchaba.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name gauchaba.com www.gauchaba.com;
    return 404; # managed by Certbot


}
## /etc/nginx/sites-enabled/simplai
server {
    listen 80;
    server_name simplai.academy www.simplai.academy;

    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
